# Copy to .env.local for local development. On Vercel, set these as environment variables.
# Mark TYPESAFE_API_KEY, APP_PASSWORD and MCP_API_KEY as type Secret.

# Required: your own TypeSafe API key for Jev
TYPESAFE_API_KEY=

# Optional: pinned Jev version. Aliases such as jev-latest are refused.
JEV_MODEL=jev-1.13.0

# Optional: alternative TypeSafe endpoint
TYPESAFE_API_URL=

# Access control: "password" (built-in page, needs APP_PASSWORD) or "platform" (a platform gate such as Vercel Authentication)
APP_AUTH=password
APP_PASSWORD=

# Optional: bearer key for the MCP server (/api/mcp) and scripted HTTP calls, 16+ characters. MCP is off when empty.
# One key, or named keys: studio:key1,claude:key2 (revoke one by removing it; the name appears in the logs).
MCP_API_KEY=

# Optional: parallel runs of a page within one score request
RUN_CONCURRENCY=8

# Tests only: simulated Jev answers and local fetching. Ignored when TYPESAFE_API_KEY is set.
# JEV_MOCK=1
