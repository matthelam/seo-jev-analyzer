  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "extract": "tsx src/adapters/web/htmlReader.ts",
    "test": "vitest run"
  },
  "dependencies": {
    "@emotion/cache": "^11.14.0",
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@fontsource/roboto": "^5.3.0",
    "@modelcontextprotocol/sdk": "1.30.1",
    "@mui/icons-material": "^7.3.11",
    "@mui/material": "^7.3.11",
    "@mui/material-nextjs": "^7.3.10",
    "@mui/x-data-grid": "^8.29.3",
    "cheerio": "1.0.0",
    "dexie": "^4.4.6",
    "dexie-react-hooks": "^1.1.7",
    "next": "^15.5.27",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
