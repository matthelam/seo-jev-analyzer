{
  "name": "seo-jev-analyzer",
  "version": "0.1.0",
  "private": true,
  "description": "Measures how closely each page of a site matches its intended search intent, using the TypeSafe Jev decision model with a measured noise floor; web app and MCP server on one engine.",
